# Copy to .env.local for local development. .env.local is gitignored.
# In production these are set in Vercel → Settings → Environment Variables.

# Safe to expose to the browser. NEXT_PUBLIC_ variables are inlined into the
# JavaScript bundle, so ONLY ever put values here that are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://rlliprxrwawwembqncxq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# The service-role key bypasses every row-level security policy in the
# database. It is not needed by this app and must never be added here, never
# be prefixed NEXT_PUBLIC_, and never be committed. If one ever leaks, rotate
# it immediately in the Supabase dashboard.
